extend schema @namespace(name: "example.library", version: "0.1.0")

# Core links (simplified subset): Borrows, RegisteredAt, AvailableAt.

type Borrows @linkType(from: "Reader", to: "Book", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type RegisteredAt @linkType(from: "Reader", to: "Branch", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type AvailableAt @linkType(from: "Book", to: "Branch", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

# Extended links (full case only as ABox; types share this file).

type Overdue @linkType(from: "Reader", to: "Book", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type Reserves @linkType(from: "Reader", to: "Book", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}

type WrittenBy @linkType(from: "Book", to: "Author", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type BelongsTo @linkType(from: "Book", to: "Category", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type PartOf @linkType(from: "Book", to: "Series", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type SpecializesIn @linkType(from: "Author", to: "Category", cardinality: MANY_TO_ONE) {
  id: ID! @primary
}

type PartnersWith @linkType(from: "Branch", to: "Branch", cardinality: MANY_TO_MANY) {
  id: ID! @primary
}
