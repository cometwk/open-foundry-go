extend schema @namespace(name: "example.library", version: "0.1.0")

type Book @objectType {
  id: ID! @primary
  isbn: String @unique @indexed
  title: String! @indexed @searchable(weight: 2.0)
  daysOnShelf: Int!
  totalCopies: Int!
  availableCopies: Int!

  branches: [Branch!]! @link(type: "AvailableAt", direction: OUTBOUND)
  borrowers: [Reader!]! @link(type: "Borrows", direction: INBOUND)
  overdueReaders: [Reader!]! @link(type: "Overdue", direction: INBOUND)
  reservedBy: [Reader!]! @link(type: "Reserves", direction: INBOUND)
  author: Author @link(type: "WrittenBy", direction: OUTBOUND)
  category: Category @link(type: "BelongsTo", direction: OUTBOUND)
  series: Series @link(type: "PartOf", direction: OUTBOUND)
}
