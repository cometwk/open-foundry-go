extend schema @namespace(name: "example.agent", version: "0.1.0")

type Chat @objectType {
  id: ID! @primary
  title: String! @indexed @searchable(weight: 2.0)
  visibility: Visibility!

  owner: Account @link(type: "OwnedBy", direction: OUTBOUND)
  messages: [Message!]! @link(type: "InChat", direction: INBOUND)
  votedMessages: [Message!]! @link(type: "Vote", direction: OUTBOUND)
}
